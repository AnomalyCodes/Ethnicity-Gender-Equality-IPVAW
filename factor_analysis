efa_vars <- efa_vars%>%mutate_all(factor)
efa_imp <- mice(efa_vars, method = "polr", m = 5, seed = 123, print = FALSE) 
efa_imp <- complete(efa_imp, 1)
efa_df <- as.data.frame(lapply(efa_df, as.factor))

#Perform EFA
# Step 1: Determine the number of factors using parallel analysis
poly_matrix <- hetcor(efa_df)$correlations
fa.parallel(poly_matrix, fa = "fa", n.obs = nrow(efa_df)) #determine num of factors
sum(is.na(efa_df))
sum(is.nan(poly_matrix))
summary(efa_df)

# Step 2: Perform EFA with the chosen number of factors
efa_result <- fa(poly_matrix, nfactors = 10, rotate = "oblimin")
efa_result_varimax <- fa(poly_matrix, nfactors = 10, rotate = "varimax")

# Step 3: Review the results
print(efa_result)
